{UTF-8}
other health service utilization=
	DELAY1( reference utilization per capita*access multiplier , time to perceive change in access\
		)
	~	1/Year
	~		|

time to perceive change in access=
	1
	~	Year
	~	Assumed that when health care access increases it takes about 1 year for \
		people to realize before they increase their utilization of the services
	|

Adjusted annual average revenue of facilities= INTEG (
	reimbursements+revenue from user fees-expenditures,
		DATA avg adjusted total unutilized internal revenue*fiscal time)
	~	Birr/facility
	~		|

fiscal time=
	1
	~	Year
	~		|

people screened for HTN in 2011= INTEG (
	 IF THEN ELSE(Time >= 2011-TIME STEP :AND: Time < 2011, people screened for NCD[HTN]\
		/TIME STEP, 0),
		 0)
	~	patient/Year
	~		|

screening effort relative to initial data year DIA=
	ZIDZ(people screened for NCD[DIA],people screened for DIA in 2011)
	~	1
	~		|

people screened for DIA in 2011= INTEG (
	 IF THEN ELSE(Time >= 2011-TIME STEP :AND: Time < 2011, people screened for NCD[DIA]\
		/TIME STEP, 0),
		 0)
	~	patient/Year
	~		|

screening effort relative to initial data year HTN=
	ZIDZ(people screened for NCD[HTN],people screened for HTN in 2011)
	~	1
	~		|

HTN screen effort=
	screening effort relative to initial data year HTN
	~	1
	~		|

DIA screen effort=
	screening effort relative to initial data year DIA
	~	1
	~		|

strategy to increase restocking=
	STEP(restock strategy strength*beta, restock strategy start year +TIME STEP)+1
	~	Dmnl
	~		|

strategy to increase enrollments=
	STEP(enrollment strategy strength*alpha, enrollment strategy start year+TIME STEP )+\
		1
	~	Dmnl
	~		|

screening promotion strategy=
	STEP(screen strategy strength*beta, screen strategy start year+TIME STEP )+1
	~	Dmnl
	~		|

strategy to decrease reimbursement delay=
	1-STEP(delay reduction strategy strength*beta, delay reduction strategy start year+TIME STEP\
		 )
	~	Dmnl
	~		|

strategy to divert unutilized revenue=
	STEP(unutilized revenue strategy strength*beta, unutilized revenue strategy start year\
		+TIME STEP )
	~	Dmnl
	~		|

strategy to increase demand responsiveness=
	STEP(responsiveness strategy strength*beta, responsiveness strategy start year+TIME STEP\
		 )+1
	~	Dmnl
	~		|

strategy to increase provider productivity=
	STEP(provider strategy strength*beta, provider productivity strategy start year+TIME STEP\
		 )
	~	Dmnl
	~		|

strategy to increase fee waivers=
	STEP(fee waiver strategy strength*alpha, fee waiver strategy start year +TIME STEP)+\
		1
	~	Dmnl
	~		|

strategy to increase provider capacity=
	STEP(provider number strategy strength*beta, provider strategy start year+TIME STEP \
		)+1
	~	Dmnl
	~		|

strategy to increase reimbursement=
	STEP(reimbursement strategy strength*beta, reimbursement strategy start year+TIME STEP\
		 )
	~	Dmnl
	~		|

implied discontinuation rate[HTN]=
	discontinuation rate[HTN]*(2/(1+demand fulfilment ratio))*(relative essential medication availability\
		^(-strength of med availability on discontinuation[HTN])) ~~|
implied discontinuation rate[DIA]=
	discontinuation rate[DIA]*(2/(1+demand fulfilment ratio))*(relative essential medication availability\
		^(-strength of med availability on discontinuation[DIA]))
	~	1/Year
	~	https://www.desmos.com/calculator/tt8ub5p7aw
	|

demand fulfilment percent=
	demand fulfilment ratio*100
	~	Dmnl
	~		|

regional internal revenue=
	total internal revenue*facilities in Amhara
	~	Birr/Year
	~		|

unutilized revenue strategy strength=
	0
	~	Dmnl [0,1]
	~		|

implied procurement responsiveness=
	strategy to increase demand responsiveness*procurement responsiveness
	~	Dmnl
	~	1 represents perfect tracking; 0 represents no response at all. 0.5: \
		partial realistic
	|

adjusted annual average RDF=
	unutilized internal revenue per facility+avg adjusted total revolving drug funds+((revenue from user fees\
		+reimbursements)*fraction allocated to RDF)
	~	Birr/(Year*facility)
	~		|

responsiveness strategy strength=
	0
	~	Dmnl [0,1]
	~		|

unutilized revenue strategy start year=
	2018
	~	Year [2010,?]
	~		|

implied medication restocking=
	base medication restocking rate*relative avg adjusted total revolving drug funds*(change in demand for medications\
		^(implied procurement responsiveness))*strategy to increase restocking
	~	1/Year
	~		|

responsiveness strategy start year=
	2018
	~	Year [2010,?]
	~		|

unutilized internal revenue per facility=
	unutilized internal revenue*strategy to divert unutilized revenue
	~	Birr/(Year*facility)
	~		|

implied enrollment rate=
	base enrollment rate*eff of perceived benefit on enrollment
	~	1/Year
	~		|

new enrollments=
	min(People in informal sector not enrolled to CBHI*implied enrollment rate*strategy to increase enrollments\
		,People in informal sector not enrolled to CBHI
	*strategy to increase enrollments/time to enroll)
	~	household/Year
	~	min(People in informal sector not enrolled to CBHI*implied enrollment rate*strategy \
		to increase enrollments,People in informal sector not enrolled to CBHI
		*strategy to increase enrollments/time to enroll)
	|

people screened for NCD[HTN]=
	max(NCD screen rate[HTN]*(Untreated NCD[HTN]+Population at risk of developing NCD[HTN\
		]),0) ~~|
people screened for NCD[DIA]=
	max(NCD screen rate[DIA]*(Untreated NCD[DIA]+Population at risk of developing NCD[DIA\
		]),0)
	~	person/Year
	~		|

productivity gap=
	target productivity-provider productivity
	~	Dmnl
	~		|

target productivity=
	0.8
	~	Dmnl
	~		|

NCD screen rate[HTN]=
	min(implied screening propensity[HTN]*eff of health coverage on screening[HTN]*demand fulfilment ratio\
		,1) ~~|
NCD screen rate[DIA]=
	min(implied screening propensity[DIA]*eff of health coverage on screening[DIA]*demand fulfilment ratio\
		,1)
	~	1/Year
	~		|

percent enrolled in insurance among eligible households=
	(CBHI beneficiaries+Fee waivered population with health coverage)/(CBHI beneficiaries\
		+People in informal sector not enrolled to CBHI+Fee waivered population with health coverage\
		)
	~	1
	~		|

reimbursement strategy strength=
	0
	~	Dmnl [0,1]
	~		|

target reimbursement=
	0.9
	~	Dmnl
	~		|

target gap=
	target reimbursement-implied CBHI reimbursement approval fraction
	~	1
	~		|

provider productivity=
	min(0.57+strategy to increase provider productivity,1)
	~	Dmnl
	~	"44% of clinical staff was not available on the day of the survey. Various reasons \
		were given for this. Amongst the clinical staff, 38% were absent because \
		of attendance to seminar sessions, 8% because of long-training, 25% were \
		on official travel and 20% were on leave. RCH clinic nurses were present \
		for 7 hours a day, but only worked productively for 57% of time present at \
		facility."
		
		https://link.springer.com/article/10.1186/1478-4491-10-3
	|

provider strategy strength=
	0
	~	Dmnl [0,1]
	~		|

provider productivity strategy start year=
	2018
	~	Year [2010,?]
	~		|

demand fulfilment ratio=
	min(1, ZIDZ(total provider minutes, total demand minutes))
	~	Dmnl
	~	min(1, ZIDZ(total NCD provider minutes, total NCD demand minutes))
		min(1, ZIDZ(total provider minutes, total demand minutes))
	|

p26=
	IF THEN ELSE( 2006<= Time :AND: Time<=2016, ZIDZ(ABS(p26 data-p26 sim),p26 data)*more weight on confidence data\
		, :NA:)
	~	Dmnl
	~		|

population cal weight=
	more weight on confidence data
	~	Dmnl
	~		|

access multiplier=
	(care capacity per capita / initial care capacity per capita)
	~	1
	~		|

total payoff=
	((
	IF THEN ELSE(p1=:NA:, 0 , p1 )+
	IF THEN ELSE(p2=:NA:, 0 , p2 )+
	IF THEN ELSE(p3=:NA:, 0 , p3 )+
	IF THEN ELSE(p4=:NA:, 0 , p4 )+
	IF THEN ELSE(p5=:NA:, 0 , p5 )+
	IF THEN ELSE(p6=:NA:, 0 , p6 )+
	IF THEN ELSE(p7=:NA:, 0 , p7 )+
	IF THEN ELSE(p8=:NA:, 0 , p8 )+
	IF THEN ELSE(p14=:NA:, 0 , p14 )+
	IF THEN ELSE(p15=:NA:, 0 , p15 )+
	IF THEN ELSE(p16=:NA:, 0 , p16 )+
	IF THEN ELSE(p17=:NA:, 0 , p17 )+
	IF THEN ELSE(p18=:NA:, 0 , p18 )+
	IF THEN ELSE(p19=:NA:, 0 , p19 )+
	
	IF THEN ELSE(p21=:NA:, 0 , p21 )+
	IF THEN ELSE(p22=:NA:, 0 , p22 )+
	IF THEN ELSE(p23=:NA:, 0 , p23 )+
	IF THEN ELSE(p24=:NA:, 0 , p24 )+
	IF THEN ELSE(p25=:NA:, 0 , p25 )+
	IF THEN ELSE(p26=:NA:, 0 , p26 )+
	IF THEN ELSE(p27=:NA:, 0 , p27 )+
	IF THEN ELSE(p28=:NA:, 0 , p28 )+
	IF THEN ELSE(p29=:NA:, 0 , p29 )+
	IF THEN ELSE(p30=:NA:, 0 , p30 )+
	IF THEN ELSE(p31=:NA:, 0 , p31 )+
	IF THEN ELSE(p32=:NA:, 0 , p32 )+
	IF THEN ELSE(p33=:NA:, 0 , p33 )
	)*(partial cal switch))
	+
	(
	IF THEN ELSE(p9=:NA:, 0 , p9 )+
	IF THEN ELSE(p10=:NA:, 0 , p10 )+
	IF THEN ELSE(p11=:NA:, 0 , p11 )+
	IF THEN ELSE(p12=:NA:, 0 , p12 )+
	IF THEN ELSE(p13=:NA:, 0 , p13 ))*(1-partial cal switch)
	~	Dmnl
	~		|

implied CBHI reimbursement approval fraction=
	min(CBHI reimbursement approval fraction DATA+strategy to increase reimbursement,1)
	~	Dmnl
	~		|

relative essential medication availability=
	ZIDZ(essential medication availability, initial essential medicine availability)
	~	Dmnl
	~		|

implied tx enrollment frac post screening[HTN]=
	base tx enrollment rate post screening[HTN]*demand fulfilment ratio*(relative essential medication availability\
		^(strength of med availability on enrollment[HTN])) ~~|
implied tx enrollment frac post screening[DIA]=
	base tx enrollment rate post screening[DIA]*demand fulfilment ratio*(relative essential medication availability\
		^(strength of med availability on enrollment[DIA]))
	~	Dmnl
	~		|

essential medication availability=
	Facilities with medication/(Facilities with medication+Facilities without medication\
		)
	~	Dmnl
	~		|

demand minutes for NCD screening=
	NCD screening related service utilization * minutes per visit
	~	minute/Year
	~		|

new enrollment into care[HTN]=
	min( people screened positive for NCD[HTN]*implied tx enrollment frac post screening\
		[HTN],
		     Untreated NCD[HTN]/transition time ) ~~|
new enrollment into care[DIA]=
	min( people screened positive for NCD[DIA]*implied tx enrollment frac post screening\
		[DIA], 
	Untreated NCD[DIA]/transition time )
	~	person/Year
	~	min( people screened positive for NCD[HTN]*base tx enrollment rate post \
		screening[HTN]*(2*demand fulfilment ratio/(1+demand fulfilment ratio
		)),
			     Untreated NCD[HTN]/transition time )
	|

strength of med availability on enrollment[HTN]=
	1 ~~|
strength of med availability on enrollment[DIA]=
	1
	~	Dmnl
	~		|

strength of med availability on discontinuation[HTN]=
	1 ~~|
strength of med availability on discontinuation[DIA]=
	1
	~	Dmnl
	~		|

DATA total providers=
	DATA general practitioners
	~	provider
	~		|

implied positive screening rate[HTN]=
	base positive NCD fraction for screened people[HTN]*relative untreated NCD[HTN] ~~|
implied positive screening rate[DIA]=
	base positive NCD fraction for screened people[DIA]*relative untreated NCD[DIA]
	~	Dmnl
	~		|

p32=
	IF THEN ELSE(2011<= Time :AND: Time<=2016,
	ZIDZ(ABS(p32 data-p32 sim), p32 data)*less weight on unconfident data, :NA:)
	~	Dmnl
	~		|

p33=
	IF THEN ELSE(2011<= Time :AND: Time<=2016,
	ZIDZ(ABS(p33 data-p33 sim), p33 data)*less weight on unconfident data, :NA:)
	~	Dmnl
	~		|

p30=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, ZIDZ(ABS(p30 data-p30 sim),p30 data
	), :NA:)
	~	Dmnl
	~		|

p31=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, ZIDZ(ABS(p31 data-p31 sim),p31 data
	), :NA:)
	~	Dmnl
	~		|

p33 sim=
	Treated NCD[DIA]
	~	patient
	~		|

DATA total DIA patients previously enrolled:INTERPOLATE:
	~	patient
	~		|

p32 data=
	IF THEN ELSE(2011<= Time :AND: Time<=2016,DATA total HTN patients previously enrolled\
		, :NA:)
	~	patient
	~		|

p32 sim=
	Treated NCD[HTN]
	~	patient
	~		|

DATA total HTN patients previously enrolled:INTERPOLATE:
	~	patient
	~		|

p33 data=
	IF THEN ELSE(2011<= Time :AND: Time<=2016,DATA total DIA patients previously enrolled\
		, :NA:)
	~	patient
	~		|

utilized internal revenue=
	total internal revenue*internal revenue execution rate
	~	Birr/(facility*Year)
	~		|

initial prevalence[HTN]=
	0.196 ~~|
initial prevalence[DIA]=
	0.078
	~	Dmnl
	~		|

initial prevalent NCD[HTN]=
	initial adult population[HTN]*initial prevalence[HTN] ~~|
initial prevalent NCD[DIA]=
	initial adult population[DIA]*initial prevalence[DIA]
	~	person
	~		|

p23=
	IF THEN ELSE( 2007<= Time :AND: Time<=2017, ZIDZ(ABS(p23 data-p23 sim),p23 data), :NA:\
		)
	~	Dmnl
	~		|

p30 sim=
	people screened positive for HTN
	~	person/Year
	~		|

initial fraction in treatment[HTN]=
	0.3 ~~|
initial fraction in treatment[DIA]=
	0.03
	~	Dmnl
	~	HTN: https://pubmed.ncbi.nlm.nih.gov/42294125/
		DIA: https://pubmed.ncbi.nlm.nih.gov/29742131/
	|

p22 sim=
	utilized internal revenue
	~	Birr/(Year*facility)
	~		|

less weight on unconfident data=
	0
	~	Dmnl
	~		|

cost to fee ratio=
	0.6
	~	Dmnl
	~		|

CBHI reimbursement approval fraction DATA=
	ZIDZ(DATA total CBHI reimbursements, DATA total CBHI reimbursements requested)
	~	Dmnl
	~		|

initial adult population[NCD]=
	INITIAL(DATA Amhara total population 30 yo plus)
	~	person
	~		|

p31 sim=
	people screened positive for DIA
	~	person/Year
	~		|

internal revenue execution rate=
	0.6
	~	Dmnl
	~	Share of retained internal revenue facilities can actually execute
	|

base provider per facility=
	2
	~	provider/facility
	~		|

procurement responsiveness=
	0.5
	~	Dmnl
	~	1 represents perfect tracking; 0 represents no response at all. 0.5: \
		partial realistic
	|

net change in provider availability=
	ZIDZ(provider gap, max provider per facility)*provider adjustment rate
	~	provider/Year
	~		|

max provider per facility=
	base provider per facility * strategy to increase provider capacity
	~	provider/facility
	~		|

annual inflation rate=
	0.25
	~	1/Year
	~		|

restocking rate=
	min(Facilities without medication*implied medication restocking
	,Facilities without medication/facility stock adjustment time
	)
	~	facility/Year
	~		|

minutes per non NCD visit=
	minutes per visit
	~	minute/patient
	~		|

total provider minutes=
	Total Providers*annual clinical minutes per provider*provider productivity
	~	minute/Year
	~		|

total annual clinical minutes per provider=
	220 * 7 * 60
	~	minute/(provider*Year)
	~	220 working days × 7 clinical hours × 60 min
		
		"44% of clinical staff was not available on the day of the survey. Various reasons \
		were given for this. Amongst the clinical staff, 38% were absent because \
		of attendance to seminar sessions, 8% because of long-training, 25% were \
		on official travel and 20% were on leave. RCH clinic nurses were present \
		for 7 hours a day, but only worked productively for 57% of time present at \
		facility."
		
		https://link.springer.com/article/10.1186/1478-4491-10-3
	|

revenue utilization time=
	1
	~	Year
	~		|

base average reimbursement per person=
	3
	~	Birr/person
	~		|

reimbursement requests from CBHIs=
	CBHI or fee waivered patient visits*base average reimbursement per person
	~	Birr/Year
	~		|

annual clinical minutes per provider=
	total annual clinical minutes per provider * fraction of day in clinic time
	~	minute/(provider*Year)
	~		|

fraction of day in clinic time=
	0.56
	~	Dmnl
	~	"44% of clinical staff was not available on the day of the survey. Various reasons \
		were given for this. Amongst the clinical staff, 38% were absent because \
		of attendance to seminar sessions, 8% because of long-training, 25% were \
		on official travel and 20% were on leave. RCH clinic nurses were present \
		for 7 hours a day, but only worked productively for 57% of time present at \
		facility."
		
		https://link.springer.com/article/10.1186/1478-4491-10-3
	|

p4=
	IF THEN ELSE( Time>=2010-1:AND:Time <=2010+1 ,  ZIDZ(ABS(p4 data-p4 sim),p4 data*2*TIME STEP\
		/OneYear)
	, :NA:)
	~	Dmnl
	~	If data are point estimates(annual values), we need to divide by TIME STEP \
		to give comparable weight in payoff (due to time series data contributing \
		to payoff every TIME STEP); otherwise priors will be under-weighted \
		proportional to TIME STEP.
	|

OneYear=
	1
	~	Year
	~		|

demand minutes for NCD=
	total NCD care demand pop * minutes per NCD patient year
	~	minute/Year
	~		|

demand minutes for non NCD=
	non NCD visits * minutes per non NCD visit
	~	minute/Year
	~		|

initial tot demand minute ratio=
	0.5
	~	Dmnl
	~		|

initial total demand minutes=
	ZIDZ(total provider minutes,initial tot demand minute ratio)
	~	minute/Year
	~		|

capacity utilization=
	ZIDZ(total demand minutes, total provider minutes)
	~	Dmnl
	~		|

non NCD visits=
	total visits - active patient NCD related service utilization - NCD screening related service utilization
	~	person/Year
	~		|

total demand minutes=
	DELAY1I(	demand minutes for non NCD
		+ demand minutes for NCD
		+ demand minutes for NCD screening,
		TIME STEP, initial total demand minutes)
	~	minute/Year
	~		|

minutes per visit=
	5
	~	minute/patient
	~	remember to include citations
	|

minutes per NCD patient year=
	annual health service utilization per NCD patient*minutes per visit
	~	minute/patient/Year
	~	 2 visits (every 6 months) × 20 min/visit =40
	|

eff of coverage on service utilization=
	1.35
	~	1
	~	Community-based health insurance (CBHI) enrolees experience a 30 to 41 \
		percent increase in health care utilization (Mebratie et al. 2019) \
		(10.1016/j.socscimed.2018.11.003). We use an average of 35%
	|

reference utilization per capita=
	0.1
	~	1/Year
	~		|

initial care capacity per capita= INITIAL(
	care capacity per capita)
	~	provider/person
	~		|

new utilization for HTN screen=
	people screened for NCD[HTN]
	~	person/Year
	~		|

p30 data=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, DATA positive result for screened HTN, :NA:\
		)
	~	person/Year
	~		|

p31 data=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, DATA positive result for screened DIA , \
		:NA:)
	~	person/Year
	~		|

new utilization for DIA screen=
	people screened for NCD[DIA]
	~	person/Year
	~		|

initial perceived benefit= INITIAL(
	percent enrolled in CBHI)
	~	Dmnl
	~		|

percent enrolled in CBHI=
	CBHI beneficiaries/(CBHI beneficiaries+People in informal sector not enrolled to CBHI\
		)
	~	Dmnl
	~		|

relative benefit=
	ZIDZ(percent enrolled in CBHI,initial perceived benefit)
	~	1
	~		|

adjusted subsidies=
	adjusted total CBHI collected fees*subsidy fraction
	~	Birr/Year
	~		|

care capacity per capita=
	Total Providers/DATA Amhara total population 30 yo plus
	~	provider/person
	~		|

alpha=
	1
	~	Dmnl
	~		|

beta=
	1
	~	Dmnl
	~		|

people screened positive for HTN=
	people screened positive for NCD[HTN]
	~	person/Year
	~		|

people screened positive for DIA=
	people screened positive for NCD[DIA]
	~	person/Year
	~		|

screen strategy start year=
	2018
	~	Year [2010,?]
	~		|

screen strategy strength=
	0
	~	Dmnl [0,1]
	~		|

p29 sim=
	adjusted subsidies
	~	Birr/Year
	~		|

implied screening propensity[HTN]=
	base NCD screening propensity[HTN]*screening promotion strategy ~~|
implied screening propensity[DIA]=
	base NCD screening propensity[DIA]*screening promotion strategy
	~	1/Year
	~		|

DATA general subsidies:INTERPOLATE:
	~	Birr/Year
	~		|

p5=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, ZIDZ(ABS(p5 data-p5 sim),p5 data
	), :NA:)
	~	Dmnl
	~		|

p5 data=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, DATA early loss to follow up HTN , :NA:)
	~	person/Year
	~		|

early discont[HTN]=
	fraction discont early*discontinuation from care[HTN] ~~|
early discont[DIA]=
	discontinuation from care[DIA]*fraction discont early
	~	person/Year
	~		|

subsidy fraction=
	0.1
	~	Dmnl
	~		|

p6 data=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, DATA early loss to follow up DIA  , :NA:\
		)
	~	person/Year
	~		|

restock strategy start year=
	2018
	~	Year [2010,?]
	~		|

restock strategy strength=
	0
	~	Dmnl [0,1]
	~		|

p6 sim=
	early loss to follow up DIA
	~	person/Year
	~		|

DATA adjusted subsidies=
	DATA general subsidies*DATA inflation conversion multiplier for 2017 birr value
	~	Birr/Year
	~		|

reimbursement strategy start year=
	2018
	~	Year [2010,?]
	~		|

CBHI reimbursements approved=
	min(reimbursement requests from CBHIs*implied CBHI reimbursement approval fraction, \
		CBHI revenue/revenue utilization time)
	~	Birr/Year
	~		|

provider strategy start year=
	2018
	~	Year [2010,?]
	~		|

p29=
	IF THEN ELSE( 2009<= Time :AND: Time<=2016, ZIDZ(ABS(p29 data-p29 sim),p29 data), :NA:\
		)
	~	Dmnl
	~		|

p29 data=
	IF THEN ELSE( 2009<= Time :AND: Time<=2016, DATA adjusted subsidies , :NA:)
	~	Birr/Year
	~		|

collected fees and subsidies=
	adjusted total CBHI collected fees+adjusted subsidies
	~	Birr/Year
	~		|

provider number strategy strength=
	0
	~	Dmnl [0,1]
	~		|

early loss to follow up HTN=
	early discont[HTN]
	~	person/Year
	~		|

p6=
	IF THEN ELSE( 2011<= Time :AND: Time<=2016, ZIDZ(ABS(p6 data-p6 sim),p6 data
	), :NA:)
	~	Dmnl
	~		|

fraction discont early=
	0.8
	~	Dmnl
	~	add citations
